# ----------------------------------------------------------------------------
# GlowCart environment variables
# Copy this file to `.env` and fill in real values.
# ----------------------------------------------------------------------------

# PostgreSQL connection string (Neon / Supabase).
# Supabase → Project Settings → Database → Connection string:
#   DATABASE_URL = pooler URI (port 6543) + ?pgbouncer=true
#   DIRECT_URL   = direct URI (port 5432) — used for prisma migrate/db push
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional — only if you use the Supabase JS SDK (storage/realtime). Not needed for Prisma.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Auth.js (NextAuth v5)
# Generate a secret with:  npx auth secret    (or)   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app (used by Auth.js callbacks)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seeded admin credentials (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@glowcart.dev"
SEED_ADMIN_PASSWORD="Admin@12345"
