# ----------------------------------------------------------------------------
# GlowCart environment variables
# Copy this file to `.env` and fill in real values.
# ----------------------------------------------------------------------------

# PostgreSQL connection string (Neon / Supabase).
# Neon example:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/glowcart?sslmode=require
# Supabase example: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/glowcart?sslmode=require"

# Auth.js (NextAuth v5)
# Generate a secret with:  npx auth secret    (or)   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app (used by Auth.js callbacks)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seeded admin credentials (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@glowcart.dev"
SEED_ADMIN_PASSWORD="Admin@12345"
